rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function account(uid) { return /databases/$(database)/documents/members/$(uid); }
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function active() { return signedIn() && get(account(request.auth.uid)).data.active == true; }
    function student() { return active() && get(account(request.auth.uid)).data.role == 'student'; }
    function teacher() { return active() && get(account(request.auth.uid)).data.role == 'teacher'; }
    function memberShape(d) {
      return d.keys().hasOnly(['nickname', 'role', 'active', 'shareProgress'])
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 32
        && d.active is bool && d.shareProgress is bool;
    }
    function verifiedEmail(email) {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }
    function invite(email) { return /databases/$(database)/documents/invites/$(email); }
    function canClaim(uid, d) {
      let email = request.auth.token.email.lower();
      let before = get(invite(email)).data;
      let after = getAfter(invite(email)).data;
      return own(uid) && verifiedEmail(email) && before.uid == '' && after.uid == uid
        && d.nickname == before.nickname && d.active == true;
    }
    match /invites/{email} {
      allow get: if teacher() || verifiedEmail(email);
      allow list: if teacher();
      allow create: if teacher() && request.resource.data.keys().hasOnly(['nickname','uid'])
        && email.size() <= 254 && email.matches('^[^@/]+@[^@/]+
      allow get: if own(uid) || teacher() || (active() && resource.data.active);
      allow list: if teacher() || (active() && resource.data.active);
      allow create: if memberShape(request.resource.data) && request.resource.data.role == 'student'
        && request.resource.data.shareProgress == false && (teacher() || (signedIn() && canClaim(uid, request.resource.data)));
      allow update: if memberShape(request.resource.data) && (
        (teacher() && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'active']))
        || (student() && own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareProgress']))
      );
    }
    function planPath(plan) { return /databases/$(database)/documents/plans/$(plan); }
    function planShape(d) {
      return d.keys().hasOnly(['title', 'subtitle', 'mode', 'start', 'days'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 90
        && d.subtitle is string && d.subtitle.size() <= 120
        && d.mode in ['daily', 'countdown']
        && d.start is int && d.start >= 0 && d.start <= 4102416000000
        && (d.start + 28800000) % 86400000 == 0
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 366;
    }
    function summaryPath(plan, uid) {
      return /databases/$(database)/documents/plans/$(plan)/progress/$(uid);
    }
    function dayPath(plan, uid, key) {
      return /databases/$(database)/documents/plans/$(plan)/checks/$(uid)/days/$(key);
    }
    function nestPath(plan, uid) {
      return /databases/$(database)/documents/plans/$(plan)/nest/$(uid);
    }
    match /plans/{plan} {
      allow read: if active();
      allow create: if teacher() && planShape(request.resource.data) && request.resource.data.start > request.time.toMillis();
      allow update: if teacher() && planShape(request.resource.data) && (
        (resource.data.start > request.time.toMillis() && request.resource.data.start > request.time.toMillis())
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'subtitle', 'mode'])
      );
      match /progress/{uid} {
        allow get: if teacher() || (student() && own(uid));
        allow list: if teacher();
        function validatesNewDay(d, oldCount) {
          return d.keys().hasOnly(['count', 'last', 'at']) && d.count is int
            && d.count == oldCount + 1 && d.at == request.time
            && d.last is string && d.last.matches('^[0-9]{1,3}$')
            && !exists(dayPath(plan, uid, d.last))
            && getAfter(dayPath(plan, uid, d.last)).data.at == request.time
            && getAfter(nestPath(plan, uid)).data.count == d.count;
        }
        allow create: if student() && own(uid) && validatesNewDay(request.resource.data, 0);
        allow update: if student() && own(uid) && validatesNewDay(request.resource.data, resource.data.count);
      }
      match /nest/{uid} {
        allow get: if teacher() || (student() && own(uid)) ||
          (active() && get(account(uid)).data.active && get(account(uid)).data.shareProgress);
        allow create, update: if student() && own(uid) && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && getAfter(summaryPath(plan, uid)).data.count == request.resource.data.count
          && getAfter(summaryPath(plan, uid)).data.at == request.time;
      }
      match /checks/{uid}/days/{key} {
        allow read: if teacher() || (student() && own(uid));
        function validDay(d) {
          let schedule = get(planPath(plan)).data;
          return d.keys().hasOnly(['index', 'at']) && d.index is int
            && d.index >= 0 && d.index < schedule.days.size() && key == string(d.index)
            && schedule.start + d.index * 86400000 <= request.time.toMillis()
            && d.at == request.time
            && getAfter(summaryPath(plan, uid)).data.last == key
            && getAfter(summaryPath(plan, uid)).data.at == request.time;
        }
        allow create: if student() && own(uid) && validDay(request.resource.data);
      }
    }
    function visibleComment() {
      return active() && (resource.data.status == 'approved' || resource.data.uid == request.auth.uid);
    }
    function publishedComment(d) {
      return active() && d.keys().hasOnly(['uid', 'body', 'status', 'createdAt'])
        && d.uid == request.auth.uid && d.status == 'approved' && d.createdAt == request.time
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 1800;
    }
    function moderation() {
      return teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.status in ['pending', 'approved', 'rejected'] && request.resource.data.status == 'hidden')
          || (resource.data.status == 'hidden' && request.resource.data.status == 'approved'));
    }
    match /posts/{post} {
      allow read: if teacher() || visibleComment();
      function chapterPost(d) {
        let plan = get(planPath(d.planId)).data;
        return d.keys().hasOnly(['uid', 'body', 'status', 'createdAt', 'planId', 'dayIndex'])
          && active() && d.uid == request.auth.uid && d.status == 'approved'
          && d.createdAt == request.time && d.body is string && d.body.size() >= 1 && d.body.size() <= 1800
          && d.planId is string && d.dayIndex is int && d.dayIndex >= 0 && d.dayIndex < plan.days.size()
          && plan.start + d.dayIndex * 86400000 <= request.time.toMillis();
      }
      allow create: if chapterPost(request.resource.data);
      allow update: if moderation();
      match /replies/{reply} {
        function openThread() {
          return get(/databases/$(database)/documents/posts/$(post)).data.status == 'approved';
        }
        allow read: if teacher() || (openThread() && visibleComment());
        allow create: if publishedComment(request.resource.data) && openThread();
        allow update: if moderation() && (request.resource.data.status != 'approved' || openThread());
      }
    }
    match /{path=**}/replies/{reply} {
      allow list: if teacher();
    }
  }
}
) && email == email.lower()
        && request.resource.data.nickname is string && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 32 && request.resource.data.uid == '';
      allow delete: if teacher() && resource.data.uid == '';
      allow update: if verifiedEmail(email) && resource.data.uid == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(account(request.auth.uid))
        && getAfter(account(request.auth.uid)).data.role == 'student';
    }
    match /members/{uid} {
      allow get: if own(uid) || teacher() || (active() && resource.data.active);
      allow list: if teacher() || (active() && resource.data.active);
      allow create: if teacher() && memberShape(request.resource.data) && request.resource.data.role == 'student' && request.resource.data.shareProgress == false;
      allow update: if memberShape(request.resource.data) && (
        (teacher() && resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'active']))
        || (student() && own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareProgress']))
      );
    }
    function planPath(plan) { return /databases/$(database)/documents/plans/$(plan); }
    function planShape(d) {
      return d.keys().hasOnly(['title', 'subtitle', 'mode', 'start', 'days'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 90
        && d.subtitle is string && d.subtitle.size() <= 120
        && d.mode in ['daily', 'countdown']
        && d.start is int && d.start >= 0 && d.start <= 4102416000000
        && (d.start + 28800000) % 86400000 == 0
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 366;
    }
    function summaryPath(plan, uid) {
      return /databases/$(database)/documents/plans/$(plan)/progress/$(uid);
    }
    function dayPath(plan, uid, key) {
      return /databases/$(database)/documents/plans/$(plan)/checks/$(uid)/days/$(key);
    }
    function nestPath(plan, uid) {
      return /databases/$(database)/documents/plans/$(plan)/nest/$(uid);
    }
    match /plans/{plan} {
      allow read: if active();
      allow create: if teacher() && planShape(request.resource.data) && request.resource.data.start > request.time.toMillis();
      allow update: if teacher() && planShape(request.resource.data) && (
        (resource.data.start > request.time.toMillis() && request.resource.data.start > request.time.toMillis())
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'subtitle', 'mode'])
      );
      match /progress/{uid} {
        allow get: if teacher() || (student() && own(uid));
        allow list: if teacher();
        function validatesNewDay(d, oldCount) {
          return d.keys().hasOnly(['count', 'last', 'at']) && d.count is int
            && d.count == oldCount + 1 && d.at == request.time
            && d.last is string && d.last.matches('^[0-9]{1,3}$')
            && !exists(dayPath(plan, uid, d.last))
            && getAfter(dayPath(plan, uid, d.last)).data.at == request.time
            && getAfter(nestPath(plan, uid)).data.count == d.count;
        }
        allow create: if student() && own(uid) && validatesNewDay(request.resource.data, 0);
        allow update: if student() && own(uid) && validatesNewDay(request.resource.data, resource.data.count);
      }
      match /nest/{uid} {
        allow get: if teacher() || (student() && own(uid)) ||
          (active() && get(account(uid)).data.active && get(account(uid)).data.shareProgress);
        allow create, update: if student() && own(uid) && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && getAfter(summaryPath(plan, uid)).data.count == request.resource.data.count
          && getAfter(summaryPath(plan, uid)).data.at == request.time;
      }
      match /checks/{uid}/days/{key} {
        allow read: if teacher() || (student() && own(uid));
        function validDay(d) {
          let schedule = get(planPath(plan)).data;
          return d.keys().hasOnly(['index', 'at']) && d.index is int
            && d.index >= 0 && d.index < schedule.days.size() && key == string(d.index)
            && schedule.start + d.index * 86400000 <= request.time.toMillis()
            && d.at == request.time
            && getAfter(summaryPath(plan, uid)).data.last == key
            && getAfter(summaryPath(plan, uid)).data.at == request.time;
        }
        allow create: if student() && own(uid) && validDay(request.resource.data);
      }
    }
    function visibleComment() {
      return active() && (resource.data.status == 'approved' || resource.data.uid == request.auth.uid);
    }
    function publishedComment(d) {
      return active() && d.keys().hasOnly(['uid', 'body', 'status', 'createdAt'])
        && d.uid == request.auth.uid && d.status == 'approved' && d.createdAt == request.time
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 1800;
    }
    function moderation() {
      return teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected'])
          || (resource.data.status in ['pending', 'approved', 'rejected'] && request.resource.data.status == 'hidden')
          || (resource.data.status == 'hidden' && request.resource.data.status == 'approved'));
    }
    match /posts/{post} {
      allow read: if teacher() || visibleComment();
      function chapterPost(d) {
        let plan = get(planPath(d.planId)).data;
        return d.keys().hasOnly(['uid', 'body', 'status', 'createdAt', 'planId', 'dayIndex'])
          && active() && d.uid == request.auth.uid && d.status == 'approved'
          && d.createdAt == request.time && d.body is string && d.body.size() >= 1 && d.body.size() <= 1800
          && d.planId is string && d.dayIndex is int && d.dayIndex >= 0 && d.dayIndex < plan.days.size()
          && plan.start + d.dayIndex * 86400000 <= request.time.toMillis();
      }
      allow create: if chapterPost(request.resource.data);
      allow update: if moderation();
      match /replies/{reply} {
        function openThread() {
          return get(/databases/$(database)/documents/posts/$(post)).data.status == 'approved';
        }
        allow read: if teacher() || (openThread() && visibleComment());
        allow create: if publishedComment(request.resource.data) && openThread();
        allow update: if moderation() && (request.resource.data.status != 'approved' || openThread());
      }
    }
    match /{path=**}/replies/{reply} {
      allow list: if teacher();
    }
  }
}
